{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@showcase-assets/*": ["../images/concept/showcase/*"],
      "@avatar-videos/face-neck-motion.mp4": ["../models/avatar-v1/charakuru/releases/k6/motion.mp4"],
      "@avatar-videos/dance-tetris-expressions.mp4": ["../models/avatar-v1/charakuru/dances/tetris-expressions/motion.mp4"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts"]
}
