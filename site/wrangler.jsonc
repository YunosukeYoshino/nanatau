{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanatau-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "nanatau.com",
      "custom_domain": true
    },
    {
      "pattern": "www.nanatau.com",
      "custom_domain": true
    }
  ]
}
